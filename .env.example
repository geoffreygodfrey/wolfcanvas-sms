DATABASE_URL=postgres://user:password@localhost:5432/outreach

# Auth — sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Telnyx — leave blank to log sends to the console instead of hitting the API
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
# Webhook verification (recommended for production): your account's base64
# Ed25519 public key (Telnyx portal → Keys & Credentials → Public Key).
# Blank = signature checks skipped.
TELNYX_PUBLIC_KEY=

# Calendar — public Cal.com booking page (https://cal.com/username/event) or the
# HTML iframe snippet from Cal.com → event → Embed → HTML iframe. Renders your
# live booking calendar on Calendar (no API key required).
CALCOM_EMBED_URL=

# Email — for password reset links. Resend API key + verified sender. Leave
# blank to log the reset link to the server console instead (dev mode).
RESEND_API_KEY=
MAIL_FROM=wolfcanvas <password-reset@yourdomain.com>

# Data retention — opted-out contacts (STOP reply / AI opt-out scenario) are
# permanently deleted this many days after opting out. Default 30.
OPT_OUT_PURGE_DAYS=30

# AI conversation agent — any OpenAI-compatible endpoint works, checked in order:
#   1. LLM_BASE_URL  + LLM_API_KEY + LLM_MODEL  — any custom host (Ollama: LLM_BASE_URL=http://localhost:11434/v1)
#   2. GROQ_API_KEY                            — free tier; model overrides via LLM_MODEL (default llama-3.3-70b-versatile)
#   3. QWEN_API_KEY / DASHSCOPE_API_KEY        — Alibaba DashScope; default model qwen-plus
# With no key at all, the agent falls back to built-in keyword heuristics.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
GROQ_API_KEY=
QWEN_API_KEY=